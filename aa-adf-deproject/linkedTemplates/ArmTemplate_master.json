{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "aa-adf-deproject"
		},
		"ls_AzureDatabricks1_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_AzureDatabricks1'"
		},
		"ls_AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0712-160137-vec7jp24"
		},
		"ls_adls_bronze_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://aastdeproject.dfs.core.windows.net/"
		},
		"ls_adls_source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://aastdeproject.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "aa-adf-deproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_AzureDatabricks1_accessToken": {
						"value": "[parameters('ls_AzureDatabricks1_accessToken')]"
					},
					"ls_AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"ls_adls_bronze_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_bronze_properties_typeProperties_url')]"
					},
					"ls_adls_source_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_source_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}